# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env никому не показывайте и не загружайте на GitHub!

# Токен бота от @BotFather
BOT_TOKEN=

# Ваш Telegram ID — сюда будут приходить заявки.
# Узнать: запустите бота и отправьте ему /id
ADMIN_ID=

# Прокси/VPN, если Telegram напрямую недоступен (необязательно).
# Если пусто — берётся системный HTTPS_PROXY. Пример: http://127.0.0.1:10809
PROXY=

# Секрет для облака (любая случайная строка)
WEBHOOK_SECRET=
